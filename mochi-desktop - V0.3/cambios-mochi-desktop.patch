+++ b/mochi-desktop - V0.3/voice_bridge/simulador.py	
@@ -0,0 +1,187 @@
+"""
+ESP32 simulado: prueba el puente sin la placa.
+
+Crea un puerto serie falso (pty), arranca el puente apuntando a ese
+puerto, "dice" una frase sintetizada con Piper y muestra lo que el
+puente le devuelve al ESP32 (estados, texto, audio).
+
+Solo Linux (usa os.openpty). Desde la carpeta de mochi-desktop:
+
+    python -m voice_bridge.simulador "qué ventanas tengo abiertas"
+    python -m voice_bridge.simulador "hola" --echo
+    python -m voice_bridge.simulador "hola" --echo --stt whisper
+
+Lo que va después de la frase se le pasa al puente tal cual.
+"""
+
+import os
+import select
+import subprocess
+import sys
+import time
+import tty
+from pathlib import Path
+
+import numpy as np
+
+from voice_bridge import protocol
+from voice_bridge.esp32_bridge import DEFAULT_PIPER_VOICE
+from voice_bridge.speech import TextToSpeech
+
+
+MOCHI_DIR = Path(__file__).resolve().parent.parent
+
+STATES = {
+    protocol.IDLE: "IDLE",
+    protocol.LISTENING: "LISTENING",
+    protocol.THINKING: "THINKING",
+    protocol.SPEAKING: "SPEAKING",
+    protocol.DONE: "DONE",
+    protocol.ERROR: "ERROR",
+}
+
+
+def synthesize_16k(text):
+    """Frase de Piper pasada a PCM 16 kHz, con silencio alrededor."""
+
+    tts = TextToSpeech(DEFAULT_PIPER_VOICE)
+    pcm = np.frombuffer(tts.synthesize(text), dtype=np.int16).astype(np.float32)
+
+    positions = np.linspace(0, len(pcm) - 1, int(len(pcm) * 16000 / tts.sample_rate))
+    pcm = np.interp(positions, np.arange(len(pcm)), pcm).astype(np.int16)
+
+    silence = np.zeros(4000, dtype=np.int16)
+
+    return np.concatenate([silence, pcm, silence]).tobytes()
+
+
+class FakeEsp32:
+
+    def __init__(self, master, bridge):
+
+        self.master = master
+        self.bridge = bridge
+        self.reader = protocol.FrameReader()
+        self.audio_bytes = 0
+        self.audio_rate = 22050
+
+
+    def _show_bridge_output(self):
+
+        try:
+            output = self.bridge.stdout.read()
+        except TypeError:
+            return
+
+        for line in (output or "").splitlines():
+            if line.strip():
+                print(f"  [puente] {line}")
+
+
+    def pump(self, seconds, until=None):
+        """Atiende el puerto hasta `until(tipo, payload)` o hasta el tiempo."""
+
+        end = time.monotonic() + seconds
+
+        while time.monotonic() < end:
+
+            self._show_bridge_output()
+
+            if self.bridge.poll() is not None:
+                self._show_bridge_output()
+                raise SystemExit("El puente terminó.")
+
+            ready, _, _ = select.select([self.master], [], [], 0.1)
+
+            if not ready:
+                continue
+
+            for msg_type, payload in self.reader.feed(os.read(self.master, 65536)):
+
+                if msg_type == protocol.HELLO_REQUEST:
+                    os.write(self.master, protocol.encode(protocol.HELLO, b"mochi-esp32 simulado"))
+
+                elif msg_type == protocol.STATE:
+                    print(f"  <- estado {STATES.get(payload[0], payload[0])}")
+
+                elif msg_type == protocol.TEXT:
+                    print(f"  <- pantalla {payload.decode('ascii', 'replace')!r}")
+
+                elif msg_type == protocol.PLAY_BEGIN:
+                    self.audio_bytes = 0
+                    self.audio_rate = int.from_bytes(payload[:4], "little") or 22050
+
+                elif msg_type == protocol.PLAY_DATA:
+                    self.audio_bytes += len(payload)
+
+                elif msg_type == protocol.PLAY_END:
+                    print(f"  <- audio {self.audio_bytes / 2 / self.audio_rate:.1f} s")
+
+                if until and until(msg_type, payload):
+                    return True
+
+        return False
+
+
+    def say(self, pcm):
+
+        os.write(self.master, protocol.encode(protocol.AUDIO_BEGIN, protocol.u32(16000)))
+
+        # Mismo ritmo que el ESP32: 256 muestras cada 16 ms.
+        for start in range(0, len(pcm), 512):
+            os.write(self.master, protocol.encode(protocol.AUDIO_DATA, pcm[start:start + 512]))
+            time.sleep(0.004)
+
+        os.write(self.master, protocol.encode(protocol.AUDIO_END))
+
+
+def is_state(*states):
+
+    return lambda msg_type, payload: msg_type == protocol.STATE and payload[0] in states
+
+
+def main():
+
+    if len(sys.argv) < 2:
+        raise SystemExit(__doc__)
+
+    phrase = sys.argv[1]
+    bridge_arguments = sys.argv[2:]
+
+    pcm = synthesize_16k(phrase)
+
+    master, slave = os.openpty()
+    tty.setraw(master)
+    tty.setraw(slave)
+
+    bridge = subprocess.Popen(
+        [sys.executable, "-m", "voice_bridge.esp32_bridge", "--port", os.ttyname(slave), *bridge_arguments],
+        cwd=MOCHI_DIR,
+        env=dict(os.environ, PYTHONUNBUFFERED="1"),
+        stdout=subprocess.PIPE,
+        stderr=subprocess.STDOUT,
+        text=True,
+    )
+    os.set_blocking(bridge.stdout.fileno(), False)
+
+    esp32 = FakeEsp32(master, bridge)
+
+    try:
+        if not esp32.pump(120, until=is_state(protocol.IDLE)):
+            raise SystemExit("El puente no arrancó.")
+
+        print(f"-> digo: {phrase!r} ({len(pcm) / 32000:.1f} s)")
+        esp32.say(pcm)
+
+        started = time.monotonic()
+        esp32.pump(300, until=is_state(protocol.DONE, protocol.ERROR))
+        print(f"-> respuesta completa en {time.monotonic() - started:.1f} s")
+
+        esp32.pump(1.0)
+
+    finally:
+        bridge.terminate()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/mochi-desktop - V0.3/voice_bridge/speech.py b/mochi-desktop - V0.3/voice_bridge/speech.py
