diff --git a/mochi-desktop - V0.3/voice_bridge/esp32_bridge.py b/mochi-desktop - V0.3/voice_bridge/esp32_bridge.py
new file mode 100644
index 0000000..226eeb3
--- /dev/null
+++ b/mochi-desktop - V0.3/voice_bridge/esp32_bridge.py	
@@ -0,0 +1,433 @@
+"""
+Puente de voz ESP32 <-> Mochi Desktop.
+
+voz -> ESP32 -> USB -> (este puente) Vosk -> command_service
+    -> LLM en la PC -> herramienta -> respuesta -> Piper -> ESP32
+
+Uso (desde la carpeta de mochi-desktop):
+
+    python -m voice_bridge.esp32_bridge
+    python -m voice_bridge.esp32_bridge --port COM5
+    python -m voice_bridge.esp32_bridge --echo     # sin LLM, repite lo que oyó
+    python -m voice_bridge.esp32_bridge --list     # puertos disponibles
+"""
+
+import argparse
+import queue
+import threading
+import time
+import traceback
+import wave
+from pathlib import Path
+
+import serial
+from serial.tools import list_ports
+
+from voice_bridge import protocol
+from voice_bridge.speech import (
+    SpeechToText,
+    TextToSpeech,
+    WhisperSpeechToText,
+    to_display_text,
+    to_speech_text,
+)
+
+
+ESPRESSIF_VID = 0x303A
+
+BRIDGE_DIR = Path(__file__).resolve().parent
+DEFAULT_VOSK_MODEL = BRIDGE_DIR / "models" / "vosk-model-small-es-0.42"
+DEFAULT_PIPER_VOICE = BRIDGE_DIR / "models" / "es_AR-daniela-high.onnx"
+
+HEARTBEAT_SECONDS = 5
+PLAY_CHUNK_BYTES = 2048
+
+# Menos que esto (en segundos) se considera un toque accidental.
+MIN_AUDIO_SECONDS = 0.3
+
+# Se agrega al final de cada orden hablada. Respuestas cortas: la
+# RX 580 genera ~12 tokens/s y cada oración son segundos de audio.
+#
+# Ojo: una indicación del tipo "respondé en una oración" hace que
+# el modelo conteste sin usar herramientas (e invente). Por eso
+# aclara que las herramientas se usan igual que siempre.
+VOICE_REPLY_HINT = (
+    "orden dictada por voz; puede tener errores de transcripción. "
+    "Usá las herramientas igual que siempre. Solo cuando termines, "
+    "la respuesta final se lee en voz alta: que sea corta, sin listas "
+    "ni formato"
+)
+
+
+# =========================================================
+# PUERTO SERIE
+# =========================================================
+
+def find_esp32_port():
+
+    for port in list_ports.comports():
+        if port.vid == ESPRESSIF_VID:
+            return port.device
+
+    return None
+
+
+class Esp32Link:
+    """Conexión serie con el ESP32. Seguro para usar desde varios hilos."""
+
+    def __init__(self, port):
+
+        # En USB nativo la velocidad se ignora.
+        self.serial = serial.Serial(port, 921600, timeout=0.1)
+        self._write_lock = threading.Lock()
+
+
+    def send(self, msg_type, payload=b""):
+
+        with self._write_lock:
+            self.serial.write(protocol.encode(msg_type, payload))
+
+
+    def state(self, value):
+
+        self.send(protocol.STATE, bytes([value]))
+
+
+    def text(self, value):
+
+        self.send(protocol.TEXT, to_display_text(value).encode("ascii"))
+
+
+    def beep(self, hz, ms):
+
+        self.send(protocol.BEEP, hz.to_bytes(2, "little") + ms.to_bytes(2, "little"))
+
+
+    def play(self, pcm, sample_rate):
+
+        self.send(protocol.PLAY_BEGIN, protocol.u32(sample_rate))
+
+        for start in range(0, len(pcm), PLAY_CHUNK_BYTES):
+            self.send(protocol.PLAY_DATA, pcm[start:start + PLAY_CHUNK_BYTES])
+
+        self.send(protocol.PLAY_END)
+
+
+    def read(self):
+
+        return self.serial.read(self.serial.in_waiting or 1)
+
+
+# =========================================================
+# EJECUCIÓN DE ÓRDENES
+# =========================================================
+
+def create_executor(echo):
+
+    if echo:
+
+        def run_echo(text):
+            return {"ok": True, "text": f"Escuché: {text}"}
+
+        return run_echo
+
+
+    # Se importa recién acá: carga todo Mochi Desktop
+    # (herramientas, Brain, conexión con el LLM).
+    from mochi_command_service import command_service
+
+    threading.Thread(
+        target=warm_up_llm,
+        args=(command_service,),
+        daemon=True,
+    ).start()
+
+    def run_command(text):
+        return command_service.execute(
+            text=text,
+            source="esp32",
+            verbose=True,
+            reply_hint=VOICE_REPLY_HINT,
+        )
+
+    return run_command
+
+
+def warm_up_llm(command_service):
+    """
+    Procesa una vez el prompt de sistema + herramientas (~4.700
+    tokens) para que llama-server lo deje en caché. Sin esto, la
+    primera orden tarda ~25 s extra en la RX 580.
+    """
+
+    from brain.agent_loop import AGENT_SYSTEM_PROMPT
+
+    started = time.monotonic()
+
+    try:
+        router = command_service.agent.router
+
+        # Las mismas tools que manda el modo "auto" del router (las
+        # reales + request_deep_reasoning, al final). Si difieren,
+        # la caché no sirve y la primera orden tarda ~80 s.
+        tools = (
+            command_service.registry.get_tool_schemas()
+            + [router._deep_request_tool()]
+        )
+
+        result = router.fast(
+            messages=[
+                {"role": "system", "content": AGENT_SYSTEM_PROMPT},
+                {"role": "user", "content": "hola"},
+            ],
+            tools=tools,
+            options={"num_predict": 1},
+        )
+    except Exception as error:
+        print(f"[llm] no pude precalentar: {error}")
+        return
+
+    if result.success:
+        print(f"[llm] listo ({time.monotonic() - started:.1f} s)")
+    else:
+        print(f"[llm] no responde: {result.error}")
+
+
+# =========================================================
+# PUENTE
+# =========================================================
+
+class VoiceBridge:
+
+    def __init__(self, link, stt, tts, execute, save_dir=None):
+
+        self.link = link
+        self.stt = stt
+        self.tts = tts
+        self.execute = execute
+        self.save_dir = save_dir
+
+        self.reader = protocol.FrameReader()
+        self.utterances = queue.Queue()
+
+        self._audio = bytearray()
+        self._audio_rate = 16000
+        self._recording = False
+        self._connected = False
+
+
+    # =====================================================
+    # HILO DE TRABAJO: una orden por vez
+    # =====================================================
+
+    def _worker(self):
+
+        while True:
+            pcm, rate = self.utterances.get()
+
+            try:
+                self._handle_utterance(pcm, rate)
+            except Exception:
+                traceback.print_exc()
+                self.link.state(protocol.ERROR)
+                self.link.text("Error interno del puente")
+
+
+    def _speak(self, text):
+
+        if not text or self.tts is None:
+            return
+
+        speech = to_speech_text(text)
+
+        if not speech:
+            return
+
+        pcm = self.tts.synthesize(speech)
+        self.link.play(pcm, self.tts.sample_rate)
+
+
+    def _handle_utterance(self, pcm, rate):
+
+        seconds = len(pcm) / 2 / rate
+
+        if seconds < MIN_AUDIO_SECONDS:
+            self.link.state(protocol.IDLE)
+            return
+
+        if self.save_dir:
+            self._save_wav(pcm, rate)
+
+        self.link.state(protocol.THINKING)
+
+        started = time.monotonic()
+        text = self.stt.transcribe(pcm, rate)
+        print(f"\n[voz] {seconds:.1f} s -> \"{text}\" ({time.monotonic() - started:.2f} s)")
+
+        if not text:
+            self.link.state(protocol.ERROR)
+            self.link.text("No te entendi")
+            self._speak("No te entendí.")
+            return
+
+        self.link.text(f"> {text}")
+
+        started = time.monotonic()
+        result = self.execute(text)
+        reply = (result.get("text") or "").strip()
+        print(f"[mochi] {result.get('status')} -> \"{reply}\" ({time.monotonic() - started:.2f} s)")
+
+        if reply:
+            self.link.text(to_speech_text(reply))
+            self.link.state(protocol.SPEAKING)
+            self._speak(reply)
+
+        self.link.state(protocol.DONE if result.get("ok") else protocol.ERROR)
+
+
+    def _save_wav(self, pcm, rate):
+
+        self.save_dir.mkdir(parents=True, exist_ok=True)
+        path = self.save_dir / time.strftime("mochi-%Y%m%d-%H%M%S.wav")
+
+        with wave.open(str(path), "wb") as wav:
+            wav.setnchannels(1)
+            wav.setsampwidth(2)
+            wav.setframerate(rate)
+            wav.writeframes(pcm)
+
+        print(f"[voz] guardado {path}")
+
+
+    # =====================================================
+    # TRAMAS DEL ESP32
+    # =====================================================
+
+    def _on_frame(self, msg_type, payload):
+
+        if msg_type == protocol.HELLO:
+            # El ESP32 contesta cada latido: se avisa solo la primera vez.
+            if not self._connected:
+                print(f"[esp32] conectado: {payload.decode('utf-8', 'replace')}")
+                self._connected = True
+            return
+
+        if msg_type == protocol.LOG:
+            print(f"[esp32] {payload.decode('utf-8', 'replace')}")
+            return
+
+        if msg_type == protocol.AUDIO_BEGIN:
+            self._audio = bytearray()
+            self._audio_rate = int.from_bytes(payload[:4], "little") or 16000
+            self._recording = True
+            print("[voz] escuchando...", end="", flush=True)
+            return
+
+        if msg_type == protocol.AUDIO_DATA and self._recording:
+            self._audio.extend(payload)
+            return
+
+        if msg_type == protocol.AUDIO_END and self._recording:
+            self._recording = False
+            self.utterances.put((bytes(self._audio), self._audio_rate))
+
+
+    # =====================================================
+    # BUCLE PRINCIPAL
+    # =====================================================
+
+    def run(self):
+
+        threading.Thread(target=self._worker, daemon=True).start()
+
+        self.link.send(protocol.HELLO_REQUEST)
+        self.link.state(protocol.IDLE)
+        last_heartbeat = time.monotonic()
+
+        print("Puente listo. Apretá el botón del ESP32 para hablar (Ctrl+C para salir).")
+
+        while True:
+            for msg_type, payload in self.reader.feed(self.link.read()):
+                self._on_frame(msg_type, payload)
+
+            # Le avisa al ESP32 que la notebook sigue ahí.
+            if time.monotonic() - last_heartbeat > HEARTBEAT_SECONDS:
+                self.link.send(protocol.HELLO_REQUEST)
+                last_heartbeat = time.monotonic()
+
+
+# =========================================================
+# MAIN
+# =========================================================
+
+def main():
+
+    parser = argparse.ArgumentParser(description="Puente de voz ESP32 <-> Mochi")
+    parser.add_argument("--port", help="puerto serie del ESP32 (por defecto, autodetectar)")
+    parser.add_argument("--list", action="store_true", help="listar puertos serie y salir")
+    parser.add_argument("--echo", action="store_true", help="no ejecutar órdenes: solo repetir lo que oyó")
+    parser.add_argument("--no-tts", action="store_true", help="no hablar, solo mostrar texto")
+    parser.add_argument("--stt", choices=["vosk", "whisper"], default="vosk", help="motor de voz a texto")
+    parser.add_argument("--whisper-model", default="small", help="tamaño de Whisper: base, small...")
+    parser.add_argument("--vosk-model", default=str(DEFAULT_VOSK_MODEL))
+    parser.add_argument("--piper-voice", default=str(DEFAULT_PIPER_VOICE))
+    parser.add_argument("--save-wav", metavar="CARPETA", help="guardar cada grabación (para ajustar el micrófono)")
+    args = parser.parse_args()
+
+    if args.list:
+        for port in list_ports.comports():
+            vid = f"{port.vid:04X}" if port.vid is not None else "----"
+            print(f"{port.device}  VID={vid}  {port.description}")
+        return
+
+    port = args.port or find_esp32_port()
+    if not port:
+        raise SystemExit("No encontré el ESP32. Conectalo al puerto USB (no UART) o usá --port. Ver --list.")
+
+    if args.stt == "whisper":
+        print(f"Cargando Whisper: {args.whisper_model}")
+        stt = WhisperSpeechToText(args.whisper_model)
+    else:
+        print(f"Cargando Vosk: {args.vosk_model}")
+        stt = SpeechToText(args.vosk_model)
+
+    tts = None
+    if not args.no_tts:
+        try:
+            print(f"Cargando Piper: {args.piper_voice}")
+            tts = TextToSpeech(args.piper_voice)
+        except Exception as error:
+            print(f"Sin voz ({error}). Sigo solo con texto en pantalla.")
+
+    execute = create_executor(args.echo)
+
+    print(f"Abriendo {port}")
+
+    try:
+        link = Esp32Link(port)
+
+    except serial.SerialException as error:
+        # Linux: sin la regla udev el puerto es solo de root/dialout.
+        if "Permission denied" in str(error) or "Permiso denegado" in str(error):
+            raise SystemExit(
+                f"Sin permiso para abrir {port}. Instalá la regla udev "
+                "(linux/99-mochi-esp32.rules, ver README.md) y reconectá el ESP32."
+            ) from error
+        raise
+
+    bridge = VoiceBridge(
+        link,
+        stt,
+        tts,
+        execute,
+        save_dir=Path(args.save_wav) if args.save_wav else None,
+    )
+
+    try:
+        bridge.run()
+    except KeyboardInterrupt:
+        print("\nCerrando puente.")
+
+
+if __name__ == "__main__":
+    main()
