index 0000000..5634898
--- /dev/null
+++ b/mochi-desktop - V0.3/voice_bridge/protocol.py	
@@ -0,0 +1,99 @@
+"""
+Protocolo serie ESP32 <-> notebook.
+
+Trama: A5 5A | tipo (u8) | largo (u16 LE) | payload
+
+La misma tabla está en firmware/mochi-esp32/src/protocol.h:
+si se cambia acá, cambiarla allá.
+"""
+
+import struct
+
+
+MAGIC = b"\xA5\x5A"
+MAX_PAYLOAD = 8192
+
+
+# ESP32 -> notebook
+HELLO = 0x01
+AUDIO_BEGIN = 0x10
+AUDIO_DATA = 0x11
+AUDIO_END = 0x12
+LOG = 0x7F
+
+# notebook -> ESP32
+HELLO_REQUEST = 0x02
+STATE = 0x20
+TEXT = 0x21
+PLAY_BEGIN = 0x30
+PLAY_DATA = 0x31
+PLAY_END = 0x32
+BEEP = 0x33
+
+
+# Estados que muestra la cara.
+IDLE = 0
+LISTENING = 1
+THINKING = 2
+SPEAKING = 3
+DONE = 4
+ERROR = 5
+
+
+def encode(msg_type, payload=b""):
+
+    if len(payload) > MAX_PAYLOAD:
+        raise ValueError("payload demasiado grande")
+
+    return MAGIC + struct.pack("<BH", msg_type, len(payload)) + payload
+
+
+def u32(value):
+
+    return struct.pack("<I", value)
+
+
+class FrameReader:
+    """Arma tramas a partir de bytes sueltos del puerto serie."""
+
+    def __init__(self):
+
+        self.buffer = bytearray()
+
+
+    def feed(self, data):
+
+        self.buffer.extend(data)
+        frames = []
+
+        while True:
+
+            start = self.buffer.find(MAGIC)
+
+            if start < 0:
+                # Conserva un posible A5 suelto al final.
+                del self.buffer[:-1]
+                break
+
+            if start > 0:
+                # Bytes que no son tramas (por ejemplo, logs del
+                # bootloader al reiniciar el ESP32).
+                del self.buffer[:start]
+
+            if len(self.buffer) < 5:
+                break
+
+            msg_type, length = struct.unpack_from("<BH", self.buffer, 2)
+
+            if length > MAX_PAYLOAD:
+                del self.buffer[:2]
+                continue
+
+            if len(self.buffer) < 5 + length:
+                break
+
+            payload = bytes(self.buffer[5:5 + length])
+            del self.buffer[:5 + length]
+            frames.append((msg_type, payload))
+
+        return frames
